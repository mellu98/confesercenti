<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' && pageTitle !== 'Home' ? pageTitle + ' — ' : '' %><%= site.name || 'Pavia Esercenti' %></title>
  <meta name="description" content="<%= site.tagline || 'Servizi, rappresentanza e opportunità per le imprese di Pavia e provincia.' %>">
  <meta name="theme-color" content="#063E32">
  <link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip-link" href="#main-content">Vai al contenuto</a>

<header class="site-header">
  <div class="utility-bar">
    <div class="site-container utility-bar__inner">
      <p>La rete delle imprese di Pavia e provincia</p>
      <div class="utility-bar__contacts">
        <% if (site.phone) { %><a href="tel:<%= String(site.phone).replace(/\s+/g, '') %>"><span class="sr-only">Telefono: </span><%= site.phone %></a><% } %>
        <% if (site.email) { %><a href="mailto:<%= site.email %>"><%= site.email %></a><% } %>
      </div>
    </div>
  </div>

  <div class="site-container site-header__inner">
    <a href="/" class="brand" aria-label="Pavia Esercenti, home">
      <img src="/images/logo-confesercenti-pavia.png" alt="Pavia Esercenti" width="640" height="270">
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Apri il menu"
      aria-expanded="false"
      aria-controls="mainNav"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span class="nav-toggle__text">Menu</span>
    </button>

    <nav class="main-nav" id="mainNav" aria-label="Navigazione principale">
      <ul>
        <li><a href="/"<% if (path === '/') { %> aria-current="page"<% } %>>Home</a></li>
        <li><a href="/associazione"<% if (path.startsWith('/associazione')) { %> aria-current="page"<% } %>>Associazione</a></li>
        <li><a href="/servizi"<% if (path.startsWith('/servizi')) { %> aria-current="page"<% } %>>Servizi</a></li>
        <li><a href="/convenzioni"<% if (path.startsWith('/convenzioni')) { %> aria-current="page"<% } %>>Convenzioni</a></li>
        <li><a href="/notizie"<% if (path.startsWith('/notizie')) { %> aria-current="page"<% } %>>Notizie</a></li>
        <li><a href="/stampa"<% if (path.startsWith('/stampa')) { %> aria-current="page"<% } %>>Stampa</a></li>
        <li><a href="/partnership"<% if (path.startsWith('/partnership')) { %> aria-current="page"<% } %>>Partnership</a></li>
      </ul>
      <a href="/contatti" class="button button--header"<% if (path.startsWith('/contatti')) { %> aria-current="page"<% } %>>Parla con noi</a>
    </nav>
  </div>
</header>

<main id="main-content" tabindex="-1">
