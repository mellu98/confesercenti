<%- include('_head') %>
<h1>Sito &amp; Pagine</h1>
<% if (saved) { %><div class="alert alert-ok">Modifiche salvate.</div><% } %>

<form method="POST" action="/admin/impostazioni" class="panel-form">
  <fieldset>
    <legend>Dati generali</legend>
    <div class="form-row">
      <label>Nome sito<input name="name" value="<%= s.name %>" required></label>
      <label>Email pubblica<input name="email" value="<%= s.email %>"></label>
    </div>
    <label>Tagline<input name="tagline" value="<%= s.tagline %>"></label>
    <div class="form-row">
      <label>Telefono<input name="phone" value="<%= s.phone %>"></label>
      <label>Orari<input name="hours" value="<%= s.hours %>"></label>
    </div>
    <label>Indirizzo sede<input name="address" value="<%= s.address %>"></label>
    <div class="form-row-3">
      <label>Facebook<input name="facebook" value="<%= s.facebook %>"></label>
      <label>Instagram<input name="instagram" value="<%= s.instagram %>"></label>
      <label>LinkedIn<input name="linkedin" value="<%= s.linkedin %>"></label>
    </div>
  </fieldset>

  <fieldset>
    <legend>Home page</legend>
    <label>Titolo hero<input name="hero_title" value="<%= h.hero_title %>"></label>
    <label>Testo hero<textarea name="hero_text" rows="3"><%= h.hero_text %></textarea></label>
    <label>Testo bottone<input name="hero_cta" value="<%= h.hero_cta %>"></label>
    <div class="form-row-3">
      <label>Numero 1<input name="stat1_n" value="<%= h.stat1_n %>"></label>
      <label>Numero 2<input name="stat2_n" value="<%= h.stat2_n %>"></label>
      <label>Numero 3<input name="stat3_n" value="<%= h.stat3_n %>"></label>
    </div>
    <div class="form-row-3">
      <label>Etichetta 1<input name="stat1_t" value="<%= h.stat1_t %>"></label>
      <label>Etichetta 2<input name="stat2_t" value="<%= h.stat2_t %>"></label>
      <label>Etichetta 3<input name="stat3_t" value="<%= h.stat3_t %>"></label>
    </div>
  </fieldset>

  <fieldset>
    <legend>Pagina Associazione</legend>
    <label>Titolo<input name="a_title" value="<%= a.title %>"></label>
    <label>Introduzione<textarea name="a_intro" rows="3"><%= a.intro %></textarea></label>
    <label>Testo (paragrafi separati da riga vuota)<textarea name="a_body" rows="10"><%= a.body %></textarea></label>
  </fieldset>

  <fieldset>
    <legend>Pagina Contatti</legend>
    <label>Introduzione<textarea name="c_intro" rows="3"><%= c.intro %></textarea></label>
  </fieldset>

  <button type="submit" class="btn">Salva tutto</button>
</form>

<form method="POST" action="/admin/password" class="panel-form" style="margin-top:32px">
  <fieldset>
    <legend>Cambia la tua password</legend>
    <div class="form-row">
      <label>Password attuale<input type="password" name="current" required></label>
      <label>Nuova password (min 8)<input type="password" name="next" required minlength="8"></label>
    </div>
    <button type="submit" class="btn btn-secondary">Aggiorna password</button>
  </fieldset>
</form>
<%- include('_foot') %>
