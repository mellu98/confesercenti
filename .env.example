# ===== OBBLIGATORIE =====
# Railway: aggiungi questa variabile di servizio e genera un valore con `openssl rand -hex 32`
SESSION_SECRET=<generate-a-long-random-value>

# Credenziali super admin (usate SOLO alla prima creazione del database)
# Railway: imposta queste variabili di servizio con valori univoci per l'ambiente.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password>

# ===== OPZIONALI =====
PORT=3000
DATA_DIR=/app/data

# ===== SMTP (per ricevere le email dai form) =====
# Se non configurate, i messaggi restano comunque salvati nell'admin
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@confesercentipavia.it
MAIL_TO=info@confesercentipavia.it
